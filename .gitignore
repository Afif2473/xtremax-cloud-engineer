# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive variable files
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Ignore CLI override and plan output binaries
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan
tfplan

# Ignore local assessment prompt/PDF or OS artifacts if desired
.DS_Store
